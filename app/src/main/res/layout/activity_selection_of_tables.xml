<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pantallas.mesas.Selection_Of_Tables"
    android:background="@drawable/fondo_default">

    <LinearLayout
        android:id="@+id/boton_de_mesas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_superior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/mesa1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:text="MESA #1"
            android:textSize="40sp"
            android:textColor="@android:color/black" />
        <Button
            android:id="@+id/mesa2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:text="MESA #2"
            android:textSize="40sp"
            android:textColor="@android:color/black" />
        <Button
            android:id="@+id/mesa3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:text="MESA #3"
            android:textSize="40sp"
            android:textColor="@android:color/black" />
        <Button
            android:id="@+id/mesa4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:text="MESA #4"
            android:textSize="40sp"
            android:textColor="@android:color/black" />
        <Button
            android:id="@+id/mesa5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:text="MESA #5"
            android:textSize="40sp"
            android:textColor="@android:color/black" />
        <Button
            android:id="@+id/mesa6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:backgroundTint="@color/white"
            android:text="MESA #6"
            android:textSize="40sp"
            android:textColor="@android:color/black" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_superior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/purple_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        android:weightSum="10">

        <Button
            android:id="@+id/button_backButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/white"
            android:src="@drawable/circle_white"
            android:text="@string/back_button" />

        <View
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="4.5" />

        <Button
            android:id="@+id/button_mapButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="4"
            android:backgroundTint="@color/brown"
            android:textColor="@color/white"
            android:text="@string/Ver_mapa"
            android:contentDescription="@string/Ver_mapa"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>