<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_default"
    tools:context=".pantallas.menuComida.EditFoodActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/purple_blue"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/circle_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar comida"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <LinearLayout
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <TextView
                android:id="@+id/labelSeleccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar comida"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginTop="24dp"
                android:layout_gravity="center_horizontal"/>

            <Spinner
                android:id="@+id/spinnerComida"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:layout_marginHorizontal="32dp"
                />

            <TextView
                android:id="@+id/labelImage2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar imagen"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"/>

            <View
                android:id="@+id/imagePlaceHolder2"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/gray_500"/>

            <TextView
                android:id="@+id/labelName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="32dp"/>

            <EditText
                android:id="@+id/inputName2"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="4dp"
                android:background="@color/gray_500"
                android:padding="10dp"
                android:hint="@string/InputNameLabel"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLength="13"
                android:textColorHint="@color/black"/>

            <TextView
                android:id="@+id/labelPrice2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="32dp"/>

            <EditText
                android:id="@+id/inputPrice2"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="4dp"
                android:background="@color/gray_500"
                android:hint="Ingrese el precio"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:inputType="numberDecimal"
                android:textSize="14sp"
                />

            <TextView
                android:id="@+id/labelType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccione los tipos"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="32dp"/>

            <TextView
                android:id="@+id/Type"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="4dp"
                android:background="@color/gray_500"
                android:padding="10dp"
                android:text="@string/selectTypesSubT"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                android:textSize="14sp"
                />

            <TextView
                android:id="@+id/labelDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_description"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="32dp"/>

            <EditText
                android:id="@+id/inputDescripcion"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="4dp"
                android:background="@color/gray_500"
                android:hint="@string/hint_description"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:gravity="start|top"
                android:textSize="14sp"
                />

            <Button
                android:id="@+id/buttonEdit"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/saveButtonText"
                android:textColor="@color/black"
                android:backgroundTint="@color/white"
                android:textSize="20sp"
                app:cornerRadius="25dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
