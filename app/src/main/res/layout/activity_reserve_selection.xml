<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pantallas.mesas.reserve_selection"
    android:background="@drawable/fondo_default">

    <androidx.cardview.widget.CardView
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.35"
        app:cardCornerRadius="14dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="#AAFFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/titulo_de_mesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Mesa #1"
                android:textColor="#000000"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="35dp"
                android:text="Hora inicio"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/textView_hora_inicio"
                android:background="@color/pastel_blue"
                android:layout_width="match_parent"
                android:textSize="20sp"
                android:layout_height="30dp"
                android:text="Selecciona la hora de inicio"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="35dp"
                android:text="Hora fin"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/textview_hora_fin"
                android:background="@color/pastel_blue"
                android:layout_width="match_parent"
                android:textSize="20sp"
                android:layout_height="30dp"
                android:text="Selecciona la hora de fin"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="35dp"
                android:text="Dia de la reserva"
                android:textColor="@color/black"/>
            <TextView
                android:id="@+id/textview_dia"
                android:background="@color/pastel_blue"
                android:layout_width="match_parent"
                android:textSize="20sp"
                android:layout_height="30dp"
                android:text="Selecciona un dia"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="35dp"
                android:text="Juego"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/juego_selc"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/pastel_blue"
                android:textSize="20sp"
                android:text="Selecciona el juego"
                android:textColor="@color/black"
                />

            <Button
                android:id="@+id/btn_aceptar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:text="aceptar"
                android:textAllCaps="false"
                android:alpha="0.9"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layout_superior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/purple_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        android:weightSum="10">

        <Button
            android:id="@+id/button_backButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/white"
            android:src="@drawable/circle_white"/>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>